# ============================================
# LinkedIn AI Post Automation — Environment
# ============================================
# Copy this file to `.env` and fill in YOUR OWN values.
# NEVER commit `.env` to git (it is gitignored).
#
# The same values must be added as GitHub Actions Secrets
# for the workflow to work in the cloud. See README.md.

# --- Required ---

# Google Gemini API key (post generation)
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LinkedIn access token (OAuth 2.0, w_member_social scope)
# Generate one with: npm run auth   (see README.md "LinkedIn Authentication")
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here

# --- Only needed to generate a new token (npm run auth) ---

# LinkedIn Developer App credentials: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
# Must exactly match the "Authorized redirect URLs" in your LinkedIn app settings
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8585/callback

# --- Optional overrides (normally configured in config/settings.json) ---

# POST_TIMEZONE=UTC
# MONDAY_TOPIC=Your Monday Topic
# WEDNESDAY_TOPIC=Your Wednesday Topic
# SCHEDULE_DAYS=monday,wednesday
# REQUIRED_HASHTAGS=#LearningInPublic,#TodayILearned
